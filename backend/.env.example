# AeroPrice backend — example environment file.
#
# Copy to backend/.env (never commit the real .env) or set the same variables
# in the Vercel dashboard. Every value below is a placeholder — replace each
# one with a real value; blanks mean "not configured" and the backend reports
# the affected feature as unavailable instead of inventing data.
#
# Frontend (Vite) variables (VITE_FIREBASE_*, VITE_AUTH_MODE, VITE_API_URL)
# are build-time browser variables, not backend variables — set those in the
# Vercel project settings, not here. See DEPLOYMENT.md §1.

# --- Environment ---
# development | production. Production refuses to start with the default
# SECRET_KEY and disables any demo-account path.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Local dev default (SQLite). Hosted deploys must use Postgres — SQLite does
# not persist on Vercel serverless. Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aeroprice
DATABASE_URL=sqlite+aiosqlite:///./aeroprice.db
# One-deploy flag: set to 1 for a single deploy to create tables on a fresh
# hosted database, then remove it.
# AEROPRICE_INIT_SCHEMA_ON_STARTUP=1

# --- Auth (backend JWT) ---
# REQUIRED in production: a long random value, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Firebase (only needed for Google sign-in / Firebase auth mode) ---
# Project id for verifying Firebase ID tokens (backend) — without it,
# POST /api/auth/firebase returns 503.
FIREBASE_PROJECT_ID=
# Server-side email lists used to resolve roles for Firebase identities.
FIREBASE_ADMIN_EMAILS=
FIREBASE_ANALYST_EMAILS=
# Service-account JSON for admin invites / the Firebase user directory.
# Paste the whole JSON object, or set FIREBASE_SERVICE_ACCOUNT_FILE to the
# path of a key file instead. Never commit a real key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# FIREBASE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# --- Seeded accounts (deploy-time only; never commit real passwords) ---
# Password for the SIH evaluator account (ANALYST role). The seed script
# backend/app/seed/evaluator.py refuses to run without this variable.
# EVALUATOR_PASSWORD=
# Password for the first admin created by scripts/bootstrap_admin.py
# (used only when the script is run with the env var instead of the
# interactive prompt).
# AEROPRICE_ADMIN_PASSWORD=

# --- Collection ---
COLLECTION_ENABLED=true
COLLECTION_INTERVAL_MINUTES=60
# Secret for the Vercel cron endpoint (POST /api/collections/cron). The cron
# 401s when this is blank.
CRON_SECRET=

# --- CORS ---
# Exact origins allowed to call the API with credentials, comma-separated.
# The production frontend is always allowed; add preview hostnames here
# explicitly — wildcard *.vercel.app origins are NOT allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443,http://127.0.0.1:5173,http://127.0.0.1:8443,https://aero-price-production.vercel.app

# --- Fare providers (blank = not configured) ---
# Amadeus Self-Service API (test env): https://developers.amadeus.com/
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_ENV=sandbox
# Duffel Air: https://app.duffel.com/join (test tokens start duffel_test_)
DUFFEL_API_TOKEN=
# SerpApi Google Flights engine (free plan: 250 searches/month)
SERPAPI_API_KEY=
# External Google Flights worker command (blank = no worker)
GOOGLEFLIGHTS_WORKER_COMMAND=

# --- Government / official data (blank = not configured) ---
MOSPI_API_EMAIL=
MOSPI_API_PASSWORD=
DATAGOV_API_KEY=
DATAGOV_AVIATION_DATASET_ID=

# --- Aviation (optional; ADSB.lol is the keyless default) ---
AVIATIONSTACK_API_KEY=
AVIATION_EDGE_API_KEY=
